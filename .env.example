# 이 파일을 .env 로 복사해서 값을 채운다. (.env 는 git에 올리지 않는다)
# docker compose 는 .env 를 자동으로 읽는다.
# Spring Boot 는 .env 를 읽지 않으므로 IntelliJ 실행 설정 또는 셸 환경변수로 같은 값을 넣는다.
DB_USERNAME=root
DB_PASSWORD=change-me
# DB_URL=jdbc:mysql://localhost:3306/djk?serverTimezone=Asia/Seoul&characterEncoding=UTF-8

# ── 운영(EC2) 서버용 ── docker-compose.prod.yml 이 읽는다
# DB_URL=jdbc:mysql://<RDS 엔드포인트>:3306/djk?serverTimezone=Asia/Seoul&characterEncoding=UTF-8
# DB_USERNAME=admin
# DB_PASSWORD=<RDS 마스터 비밀번호>
# SPRING_PROFILES_ACTIVE=dev   # Swagger 가 필요할 때만
